{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "notas-devolucao-app",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "streamlit",
        "run",
        "app.py",
        "--server.headless",
        "true"
      ],
      "port": 8501
    },
    {
      "name": "portal-modo-nuvem",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "streamlit",
        "run",
        "app.py",
        "--server.headless",
        "true",
        "--server.port",
        "8502"
      ],
      "port": 8502,
      "env": {
        "PORTAL_MODO_NUVEM": "1"
      }
    }
  ]
}
